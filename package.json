{
	"name": "civitai-stickerize-example",
	"private": false,
	"version": "1.0.0",
	"description": "SvelteKit example app: Civitai OAuth + orchestrator (Nano Banana 2) image generation with per-user Buzz billing",
	"type": "module",
	"packageManager": "pnpm@10.28.1",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"visual-test": "tsx scripts/visual-test.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/kit": "^2.50.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.1.18",
		"@types/better-sqlite3": "^7.6.13",
		"@types/jsonwebtoken": "^9.0.10",
		"drizzle-kit": "^0.31.8",
		"playwright": "^1.58.1",
		"svelte": "^5.48.2",
		"svelte-check": "^4.3.5",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@civitai/app-sdk": "^0.1.0",
		"@google/genai": "^1.39.0",
		"@openrouter/sdk": "^0.12.35",
		"better-sqlite3": "^12.6.2",
		"browser-image-compression": "^2.0.2",
		"drizzle-orm": "^0.45.1",
		"jsonwebtoken": "^9.0.3",
		"lucide-svelte": "^0.563.0",
		"zod": "^4.3.6"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3"
		]
	}
}
