# =============================================================================
# Required — Civitai OAuth (the only sign-in method this app supports)
# =============================================================================
# Register a confidential OAuth app at https://civitai.com/user/account → OAuth Apps
# Set the redirect URI to ${BASE_URL}/api/auth/oauth/civitai/callback
OAUTH_CIVITAI_CLIENT_ID=
OAUTH_CIVITAI_CLIENT_SECRET=
# 32+ char hex string used to AES-encrypt the Civitai OAuth state cookie and
# the per-user sealed token blob stored in users.civitai_tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CIVITAI_SESSION_SECRET=

# =============================================================================
# Required — image generation
# =============================================================================
# Per-user Buzz path uses the OAuth token. For users without OAuth, set this
# personal API key (Buzz debits from the key owner). Leave blank to fall
# through to the Gemini fallback below.
CIVITAI_API_TOKEN=

# Gemini fallback — used only when CIVITAI_API_TOKEN is unset.
# Get from https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# =============================================================================
# Required — LLM for photo validation + prompt enhancement
# =============================================================================
# OpenRouter (https://openrouter.ai/keys). Any vision-capable model works.
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-opus-4.5

# =============================================================================
# Required — JWT session signing
# =============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=

# =============================================================================
# Optional
# =============================================================================
# Base URL is used for the Civitai OAuth callback URL. Match what you set in
# the Civitai OAuth app's redirect URI.
BASE_URL=http://localhost:5173

# Override only for self-hosted Civitai instances.
CIVITAI_BASE_URL=https://civitai.com
CIVITAI_ORCHESTRATOR_URL=https://orchestration.civitai.com

# Flat cost (in cents) recorded per generation when not using Civitai Buzz
IMAGE_GEN_COST_CENTS=3

# Output image compression (PNG ~5MB → WebP ~100KB)
IMAGE_OPTIMIZATION_ENABLED=false
IMAGE_OPTIMIZATION_FORMAT=webp
IMAGE_OPTIMIZATION_QUALITY=80
